{
  "name": "@massimiliano-dev/fatturapa-openapi-it",
  "version": "0.1.0",
  "description": "Openapi.it SDI provider for fatturapa-client: send FatturaPA XML to SDI, receive notifications and supplier invoices via callbacks, sandbox simulation.",
  "license": "MIT",
  "author": "Massimiliano Polce",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/massimiliano-dev/fatturapa-client.git",
    "directory": "packages/openapi-it"
  },
  "homepage": "https://github.com/massimiliano-dev/fatturapa-client#readme",
  "bugs": "https://github.com/massimiliano-dev/fatturapa-client/issues",
  "keywords": [
    "fatturapa",
    "fattura-elettronica",
    "sdi",
    "sistema-di-interscambio",
    "e-invoicing",
    "italy",
    "xml",
    "openapi.it"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "@massimiliano-dev/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@massimiliano-dev/fatturapa-core": "workspace:^",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@massimiliano-dev/fatturapa-fixtures": "workspace:*"
  }
}
