# Copy to .env (gitignored) for local live tests. Sandbox credentials only.
FATTURAPA_LIVE=sandbox
OPENAPI_IT_SANDBOX_TOKEN=
OPENAPI_IT_SANDBOX_FISCAL_ID=
# Fatture in Cloud has no sandbox: use a dedicated test company (read-only test).
FIC_ACCESS_TOKEN=
FIC_COMPANY_ID=
INVOICETRONIC_SANDBOX_API_KEY=
ACUBE_SANDBOX_EMAIL=
ACUBE_SANDBOX_PASSWORD=
FEA_TEST_CLIENT_ID=
FEA_TEST_CLIENT_SECRET=
ARUBA_DEMO_USERNAME=
ARUBA_DEMO_PASSWORD=
# Optional: where `pnpm sync:schemas` wrote the official schemas.
FATTURAPA_SCHEMAS_DIR=vendor/fatturapa-schemas
